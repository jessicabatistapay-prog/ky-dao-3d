# Cổng và địa chỉ server lắng nghe
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Origin trình duyệt được phép kết nối, phân tách bằng dấu phẩy.
# Để trống khi frontend và backend cùng một tên miền.
ALLOWED_ORIGINS=https://kydao.example.com

# Đặt 1 khi chạy sau reverse proxy để lấy đúng IP cho rate limit.
TRUST_PROXY=1

# Thư mục dữ liệu SQLite và thư mục frontend đã build
DB_PATH=/data/kydao.sqlite
STATIC_DIR=/app/apps/web/dist

# Các giới hạn, thường không cần đổi
RECONNECT_GRACE_MS=120000
OFFER_TTL_MS=30000
ROOM_EMPTY_TTL_MS=600000
ROOM_FINISHED_TTL_MS=1800000
RATE_CREATE_PER_MIN=10
RATE_JOIN_PER_MIN=30
RATE_WRONG_PASSWORD_PER_MIN=6
RATE_CHAT_COUNT=5
RATE_CHAT_WINDOW_MS=10000

# Tên miền cho Caddy trong docker-compose
DOMAIN=kydao.example.com
